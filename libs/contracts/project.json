{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/contracts",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/contracts/validate.mjs"
      }
