{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/contracts",
  "projectType": "library",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec openapi-typescript libs/contracts/openapi.json -o libs/contracts/generated/api.d.ts",
          "GOPROXY=${GOPROXY:-https://goproxy.cn} go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.8.0 -config libs/contracts/oapi-codegen.yaml libs/contracts/openapi.json"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/contracts/validate.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test libs/contracts/validate.test.mjs"
      }
    }
  }
}
