{
  "name": "live-stream-lab",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "infra:up": "sh scripts/compose.sh up -d --wait",
    "infra:down": "sh scripts/compose.sh down",
    "infra:ps": "sh scripts/compose.sh ps",
    "infra:logs": "sh scripts/compose.sh logs -f"
  },
  "dependencies": {
    "mpegts.js": "1.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nx": "23.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
